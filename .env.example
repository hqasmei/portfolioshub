# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Convex client URL (*.convex.cloud). The `.cloud` -> `.site` swap in
# src/lib/get-image-url.ts derives the HTTP-action origin that serves images.
PUBLIC_CONVEX_URL=

# Clerk. svelte-clerk reads these from $env/dynamic/public|private, so they are
# runtime values on Cloudflare (Worker vars/secrets), not baked into the bundle.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PUBLIC_CLERK_SIGN_IN_URL=/sign-in
PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard

# projectplannerai.com project id, used by the feedback form and event tracking
PUBLIC_PROJECT_PLANNER_AI_ID=

# Absolute site origin, used by robots.txt, sitemap.xml and OG tags
PUBLIC_SITE_URL=http://localhost:5173

# Set on the Convex deployment itself (`npx convex env set NAME value`), not
# here. The review pipeline in convex/review.ts runs there, so its credentials
# live there too:
#   CLERK_JWT_ISSUER_DOMAIN, CLERK_WEBHOOK_SECRET, RECAPTCHA_SECRET_KEY
#   PUBLIC_SITE_URL                        -- deep link back to /admin in the review email
#   CLOUDFLARE_ACCOUNT_ID                  -- account that owns the Browser Rendering quota
#   CLOUDFLARE_BROWSER_RENDERING_TOKEN     -- API token, "Browser Rendering: Edit"
#   SECLAI_API_KEY                         -- runtime key, NOT the user-scoped MCP key
#   SECLAI_AGENT_ID                        -- the "Portfolio Submission Reviewer" agent
