{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolioshub",
	"main": ".svelte-kit/cloudflare/_worker.js",
	// >= 2024-09-23 so that `nodejs_compat` implies v2 behaviour.
	// `nodejs_compat` is required by @clerk/backend (pulled in via svelte-clerk/server).
	"compatibility_date": "2025-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
	// Custom domains are added once the zone is moved from Route 53 to Cloudflare:
	// "routes": [
	//   { "pattern": "portfolioshub.com", "custom_domain": true },
	//   { "pattern": "www.portfolioshub.com", "custom_domain": true }
	// ]
}
